# ============================================================
# Nova AI — FastAPI backend environment variables
# Copy this file to `.env` (never commit the real .env) and fill in
# real values. Every key here has a genuinely free tier — see
# ai-system/README.md for exactly where to get each one from a phone
# browser.
# ============================================================

# Same Supabase project already used by the main Ttbik/سوق تولز site —
# NovaUser/NovaUsageLog/NovaSubscription live there in isolated tables
# (prisma/migration_19_nova_ai.sql). Use the SERVICE ROLE key here, not
# the anon key — this backend bypasses RLS like every other server-side
# piece of this project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Primary always-on "brain" — free, fast, hosts big open models so we
# never have to self-host a giant model ourselves. Groq's hosted
# catalog changes over time — check https://console.groq.com/playground
# (the model dropdown) for what's currently available on YOUR account
# before assuming this default still applies.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secondary council member, for cross-checking / mixture-of-agents.
# Get a free key at https://aistudio.google.com/apikey
# Gemini's free-tier catalog changes over time too (gemini-2.0-flash was
# retired 2026-03-03, then gemini-2.5-flash itself was retired for new
# callers by 2026-09-06) — check https://ai.google.dev/gemini-api/docs/models
# for what's currently live on the free tier before assuming this default
# still applies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Third council member (optional): your own self-merged specialist
# model, produced by ai-system/colab/merge_and_finetune.py and pushed
# to your Hugging Face Hub account. Leave HF_SPECIALIST_MODEL_ID empty
# to skip this council member entirely (Groq + Gemini alone still work
# fine) until you've actually run the Colab notebook once.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_SPECIALIST_MODEL_ID=

# Our own self-hosted image-GENERATION model (Stable Diffusion family —
# see ai-system/colab/generate_image_model.ipynb), separate from
# HF_SPECIALIST_MODEL_ID above (which only UNDERSTANDS images, not
# generates them). Leave empty to skip the /صورة bot command entirely.
HF_IMAGE_MODEL_ID=

# Shared secret between this backend and Ttbik's own servers (the
# NOVA_BOT Telegram template + the Streamlit web app) — required on
# every /chat call whose channel is TELEGRAM or WEB, so a random caller
# can't impersonate someone else's telegramId/email to drain their
# quota. Generate any long random string and set the SAME value here
# and as NOVA_INTERNAL_SECRET on the Ttbik/Vercel side.
NOVA_INTERNAL_SECRET=

# Free-tier daily message quota per user before they need PRO.
FREE_DAILY_QUOTA=20

# Real vision inference on the free ModelScope box (CPU-only) can take
# several minutes for one photo — far past what a single Vercel
# function invocation can wait for. /image answers Telegram directly
# from this service instead, once the model is actually done, so it
# needs the bot's own token to call Telegram's sendMessage API itself.
# Same token as NOVA_BOT's deploy on the Ttbik/Vercel side (BotFather).
NOVA_BOT_TOKEN=

# ============================================================
# Nova AI — FastAPI backend environment variables
# Copy this file to `.env` (never commit the real .env) and fill in
# real values. Every key here has a genuinely free tier — see
# ai-system/README.md for exactly where to get each one from a phone
# browser.
# ============================================================

# Same Supabase project already used by the main Ttbik/سوق تولز site —
# NovaUser/NovaUsageLog/NovaSubscription live there in isolated tables
# (prisma/migration_19_nova_ai.sql). Use the SERVICE ROLE key here, not
# the anon key — this backend bypasses RLS like every other server-side
# piece of this project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Primary always-on "brain" — free, fast, hosts big open models so we
# never have to self-host a giant model ourselves. Groq's hosted
# catalog changes over time — check https://console.groq.com/playground
# (the model dropdown) for what's currently available on YOUR account
# before assuming this default still applies.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secondary council member, for cross-checking / mixture-of-agents.
# Get a free key at https://aistudio.google.com/apikey
# Gemini's free-tier catalog changes over time too (gemini-2.0-flash was
# retired 2026-03-03, then gemini-2.5-flash itself was retired for new
# callers by 2026-09-06) — check https://ai.google.dev/gemini-api/docs/models
# for what's currently live on the free tier before assuming this default
# still applies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Real, live serving for EVERYTHING our own model does — text, vision,
# AND image generation alike (as of 2026-09-09) — on a ModelScope
# Studio: our own trained Qwen2.5-VL model plus our own Stable
# Diffusion model, both running as one Gradio app we deployed ourselves
# (free 2 vCPU/16GB, CPU-only — see ai-system/modelscope-studio/app.py).
# One platform, one thing to configure. Hugging Face is no longer part
# of live serving at all (confirmed live, repeatedly: its free
# Inference tier flatly refuses ANY custom/private repo for ANY task —
# see council.py's module docstring) — it's only used to archive
# trained weights now, nothing you need to configure here.
# MODELSCOPE_SPACE_URL looks like
# https://studio-<owner>-<space>.api-inference.modelscope.net/ (from
# the Studio's own "API documentation" page). MODELSCOPE_API_TOKEN is a
# personal access token from modelscope.cn account settings (format
# "ms-xxxxx") — required even for a Studio marked public.
MODELSCOPE_SPACE_URL=
MODELSCOPE_API_TOKEN=

# Superseded 2026-09-12 by Cloudflare Workers AI below for the common
# case (real, GPU-served, answers in seconds) — CogVideoX-2B on Kaggle's
# scheduled free T4 GPU (ai-system/colab/process_video_queue.ipynb)
# remains as the real, working fallback for whenever Cloudflare's free
# daily quota is already used up (see quota.enqueue_video).

# Owner spec, 2026-09-12 ("حل نهائي ودائم للصوت والفديو والصور... ليس
# عبر ترميم"): Cloudflare Workers AI — a genuinely free ($0, no credit
# card, "Workers Free" plan, 10,000 shared "Neurons"/day, resets daily
# at 00:00 UTC), always-on, GPU-served host. Tried FIRST now for image
# generation (real quality jump over ModelScope's distilled sd-turbo),
# real video generation (answers inline in seconds instead of the
# Kaggle queue's up-to-~2h batch), and narration audio (replacing
# gTTS's unofficial, timeout-prone endpoint) — see
# ai-system/app/cloudflare_ai.py's module docstring for the full
# reasoning. Every existing fallback (ModelScope for images, the Kaggle
# queue for video) still works unchanged for whenever this daily free
# pool is already used up.
#
# Sign up free: https://dash.cloudflare.com/sign-up (email+password
# only, no card). Account ID and a scoped "Workers AI" API Token are
# both shown on the account's Workers AI dashboard page.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Real model IDs from developers.cloudflare.com/workers-ai/models — this
# catalog changes over time like Groq's/Gemini's does (see those vars
# above), so check that page for the current exact slug before assuming
# these defaults (already set in config.py, only need overriding here
# if wrong) still apply. CLOUDFLARE_VIDEO_MODEL in particular is an
# UNCONFIRMED guess (see config.py's own comment) — verify the real
# text-to-video model slug from the dashboard's model catalog (it shows
# a copyable exact ID per model) and set it here if different.
CLOUDFLARE_IMAGE_MODEL=
CLOUDFLARE_VIDEO_MODEL=
CLOUDFLARE_TTS_MODEL=

# Owner spec, 2026-09-12 (real second free-GPU lane, found once
# Cloudflare's own video catalog was confirmed live to have no real
# free first-party model): Hugging Face Spaces' free "ZeroGPU" hardware
# tier — real NVIDIA H200 time, tried FIRST for video generation (see
# ai-system/app/hf_video.py's module docstring for the full reasoning,
# including the one honestly-unverified part). Falls back to the
# existing Kaggle queue automatically on any failure — nothing above
# breaks if this section is left empty.
#
# One-time setup: create a free account at huggingface.co, then a new
# Space at huggingface.co/new-space (SDK: Gradio, Hardware: ZeroGPU) —
# note its "username/space-name" id for HF_VIDEO_SPACE_ID below. Get
# HF_TOKEN from huggingface.co/settings/tokens (Write scope — needed
# both for this Space's own CI deploy, see
# .github/workflows/deploy-hf-video-space.yml, and for calling it here
# at request time).
HF_TOKEN=
HF_VIDEO_SPACE_ID=

# The platform owner's own Telegram numeric ID — exempt from every
# daily/weekly quota cap in quota.py's check_and_reserve_quota (the
# owner is never a customer of their own product). Same env var
# novaBotLogic.ts already reads on the Vercel side for admin-panel
# recognition — set it here too on Render with the SAME value.
SUPER_ADMIN_TELEGRAM_ID=

# Owner spec, 2026-09-12: second factor for "owner mode" (Nova
# addressing the owner as its own developer in conversation, AND the
# quota exemption above — quota.is_platform_owner now requires BOTH
# SUPER_ADMIN_TELEGRAM_ID above AND this). Pick any password, set it
# here on Render ONLY (novaBotLogic.ts on Vercel never needs its own
# copy — it just relays whatever the owner types to this backend,
# which does the real comparison). After setting this and running
# prisma/migration_24_nova_owner_verification.sql once in Supabase,
# send "/تفعيل_المالك <this password>" once from your own Telegram
# account — that one-time command is what actually turns owner mode
# on; setting this env var alone does nothing by itself.
NOVA_OWNER_PASSWORD=

# Shared secret between this backend and Ttbik's own servers (the
# NOVA_BOT Telegram template + the Streamlit web app) — required on
# every /chat call whose channel is TELEGRAM or WEB, so a random caller
# can't impersonate someone else's telegramId/email to drain their
# quota. Generate any long random string and set the SAME value here
# and as NOVA_INTERNAL_SECRET on the Ttbik/Vercel side.
NOVA_INTERNAL_SECRET=

# Tiered plan limits (FREE/PRO_BASIC/PRO_PLUS/PRO_ULTRA — daily+weekly
# text/image caps, prices) now live in ai-system/app/quota.py's PLANS
# dict, not an env var — edit that file directly to change any number.

# Owner spec, 2026-09-12 ("أداة اقتراح تعديل الكود... PR-only"): the
# Dev Agent (ai-system/app/dev_agent.py) — owner-only, creates a new
# branch + Pull Request via GitHub's API for review, NEVER writes to
# the base branch directly and NEVER merges. Create a Fine-grained
# Personal Access Token at https://github.com/settings/tokens
# (owner-only, per-repo): Repository access -> "Only select
# repositories" -> this repo only. Permissions -> Contents:
# Read and write, Pull requests: Read and write. NOTHING else (no
# Administration, no Workflows). Paste the token here on Render only —
# never in novaBotLogic.ts/Vercel, never in any file in this repo.
NOVA_DEV_AGENT_GITHUB_TOKEN=
# "owner/repo" form, e.g. jonsnow-org/Ttbik — must match the repo the
# token above was scoped to.
NOVA_DEV_AGENT_REPO=
# The branch every proposal is forked from and every PR targets —
# this project's real current working branch (check with `git branch`
# locally if unsure), NOT necessarily "main".
NOVA_DEV_AGENT_BASE_BRANCH=

# Real vision inference on the free ModelScope box (CPU-only) can take
# several minutes for one photo — far past what a single Vercel
# function invocation can wait for. /image answers Telegram directly
# from this service instead, once the model is actually done, so it
# needs the bot's own token to call Telegram's sendMessage API itself.
# Same token as NOVA_BOT's deploy on the Ttbik/Vercel side (BotFather).
NOVA_BOT_TOKEN=

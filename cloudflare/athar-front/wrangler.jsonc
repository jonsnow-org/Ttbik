{
  // Athar's permanent front door (see ../athar-front-worker.js and docs/ATHAR_REDUNDANCY.md).
  // Cloudflare Workers Builds: root directory = cloudflare/athar-front, deploy command = npx wrangler deploy, production branch = main.
  "name": "athar-meta",
  "main": "../athar-front-worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Also publishes the site gate (../site-gate) from this same run, because that is the only deploy pipeline connected to the account.
  // It can never block or change Athar's own deploy: time-limited, and any failure is swallowed.
  "build": { "command": "CI=true timeout 240 npx wrangler deploy -c ../site-gate/wrangler.jsonc || echo 'site-gate deploy skipped'" }
}

{
  // Optional: deploy with `npx wrangler deploy` instead of pasting worker.js in the dashboard (see README.md)
  "name": "ttbik-gate",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "PRIMARY_ORIGIN": "https://89-168-89-15.sslip.io",
    "SECONDARY_ORIGIN": "https://ttbik.vercel.app",
    "ALERT_CHAT_ID": ""
  }
  // add after creating the KV namespace:  "kv_namespaces": [{ "binding": "GATE", "id": "<namespace id>" }]
  // secrets (never in this file):  wrangler secret put GATE_KEY   and   wrangler secret put ALERT_BOT_TOKEN
}

# The throw-away computer each task gets (RUNNER_MODE=docker): Linux with node, python3, git and build tools, user 1000, no sudo.
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 python3-pip python3-venv curl ca-certificates build-essential bash procps less jq unzip \
 && rm -rf /var/lib/apt/lists/* \
 && (id -u 1000 >/dev/null 2>&1 || useradd -m -u 1000 coder)
ENV PIP_USER=1 PYTHONUSERBASE=/work/.local NPM_CONFIG_PREFIX=/work/.npm-global PATH=/work/.local/bin:/work/.npm-global/bin:$PATH
USER 1000:1000
WORKDIR /work
CMD ["sleep", "infinity"]

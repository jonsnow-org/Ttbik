{
  "name": "coder sandbox runner",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8790],
  "portsAttributes": { "8790": { "label": "coder runner", "onAutoForward": "silent" } },
  "secrets": { "CODER_SANDBOX_SECRET": { "description": "Same value as CODER_CODESPACES_RUNNER_SECRET on the site" } },
  "postStartCommand": "bash .devcontainer/start-runner.sh"
}

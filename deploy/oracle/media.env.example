# Media-bot engine settings. Copy the SAME values you use on Render (Render dashboard -> Environment).
BOT_TOKEN=
OWNER_ID=
ARCHIVE_CHANNEL_ID=
FORCE_SUB_CHANNEL=
ENABLE_GLOBAL_FEED=false

# Where the site / Telegram front door lives: the gate (docs/HOSTING.md). Vercel is paused since 2026-11-07.
FEED_API_URL=https://ttbik-gate.jonsnowx1r.workers.dev/api/media-feed
#   MINI_APP_URL=https://ttbik-gate.jonsnowx1r.workers.dev/mini-app
FEED_SECRET=

# Optional (only if you already use them on Render)
YTDLP_COOKIES=
PROXY_URL=
COBALT_API_KEY=

# Telegram's cloud Bot API accepts files up to 50MB. Keep a little below.
MAX_FILE_BYTES=50331648

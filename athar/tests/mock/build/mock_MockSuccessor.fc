(slice, ((int))) $MockSuccessor$_load(slice sc_0) inline;

;; $Context$_get_value
_ $Context$_get_value((int, slice, int, slice) v) inline;

;; $MockSuccessor$_contract_init
(int) $MockSuccessor$_contract_init() impure inline;


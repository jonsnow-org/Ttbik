# ===== Supabase (Free Tier — supabase.com) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Telegram Bot (Free — via @BotFather) =====
TELEGRAM_BOT_TOKEN=
# Your personal chat_id (get it from @userinfobot on Telegram)
TELEGRAM_ADMIN_CHAT_ID=
# Any random string you invent, used to verify webhook calls really come from Telegram
TELEGRAM_WEBHOOK_SECRET=
# Public channel username (e.g. @yourchannel) the bot auto-posts marketing to daily.
# Requires the bot to be an Admin in that channel with permission to post messages.
TELEGRAM_CHANNEL_ID=
# Any random string you invent, used to verify the daily cron request is legitimate
CRON_SECRET=

# ===== Daily channel post: AD_BOT awareness (optional) =====
# Leave empty to just skip this post type (the free/paid-service posts
# keep working normally either way, no error). NOT the same bot as
# TELEGRAM_BOT_TOKEN above (that one only sends this cron's own channel
# posts and runs no AD_BOT template logic at all).
#
# Public @username (no @) of an AD_BOT-template bot you already have
# running (e.g. your own admin/management instance) — every AD_BOT already
# has a self-serve "أريد بوتاً مماثلاً" button that walks a buyer through
# the $100 manual purchase itself, so this is the only value this post
# type needs; no separate contact link.
# There is deliberately no equivalent MARRIAGE_BOT promo variable: the
# owner confirmed (2026-09-03) that template is never sold or activated
# for anyone else — it's their own private bot, and its creator password
# exists only so they can redeploy it themselves if needed, not as a sales
# path for a third party.
PROMO_AD_BOT_USERNAME=

# ===== Admin dashboard login (invent your own password) =====
ADMIN_PASSWORD=

# ===== Groq Free API (console.groq.com — free, no card) =====
GROQ_API_KEY=

# ===== Payment details shown to customers =====
# US bank transfer (ACH). NEVER commit real values here — set these directly
# as encrypted Environment Variables in your hosting dashboard (e.g. Vercel).
# Deliberately WITHOUT the NEXT_PUBLIC_ prefix: they are read only by
# /api/payment-info on the server and sent to the browser on request, never
# baked into the public JS bundle that every visitor downloads.
BANK_HOLDER=
BANK_ACCOUNT_NUMBER=
BANK_ROUTING_NUMBER=
BANK_ACCOUNT_TYPE=Checking
BANK_NAME=
BANK_ADDRESS=

USDT_ADDRESS=
USDT_NETWORK=TRC20

# ===== Multi-Tenant Telegram Bot Platform (Prisma + grammy) =====
# Postgres connection string for Prisma — from Supabase dashboard: Connect
# (top of project) → ORMs → Prisma → "Session pooler" (NOT "Direct
# connection", which is IPv6-only and unreachable from most IPv4-only
# hosts/networks — a common cause of `prisma db push`/migrate hanging or
# failing). The Session Pooler works for both app queries and migrations,
# so this one URL is all Prisma needs. Same Supabase Postgres database this
# project already uses — Prisma is just a second, separate client library
# talking to it (not a second database).
DATABASE_URL=

# Your own numeric Telegram user id (get it from @userinfobot). Whoever
# matches this id gets the /admin panel inside every deployed AD_BOT —
# broadcast, global forced ads, revenue stats, withdrawal approvals.
SUPER_ADMIN_TELEGRAM_ID=

# ===== MARRIAGE_BOT creator gate =====
# A static password YOU choose, required on the /bots page before a
# MARRIAGE_BOT (بوت التعارف والزواج الشرعي) can be deployed — completely
# separate from the AD_BOT's paid activation-code/BotPurchase system,
# which doesn't apply to this template. Set the real value only as a
# Vercel Environment Variable — never commit it here.
MARRIAGE_BOT_CREATOR_PASSWORD=

# ===== NOWPayments (real automated multi-chain crypto deposits) =====
# Powers the bot's "المحفظة" → "إيداع" flow and the /pay page — the user
# picks their chain (USDT-TRC20/BEP20/TON, TRX, TON, LTC, SOL...) on
# NOWPayments' own hosted checkout; this app never touches a private key.
#   1. Dashboard → API keys → create a key → NOWPAYMENTS_API_KEY.
#   2. Dashboard → Settings → IPN → callback URL:
#      https://ttbik.vercel.app/api/payments/webhook → copy the IPN
#      secret it gives you into NOWPAYMENTS_IPN_SECRET.
#   3. Add both as encrypted Environment Variables in Vercel, redeploy.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ===== Native TON custodial hot wallet (owner spec, 2026-09-02) =====
# A SECOND, direct deposit/withdrawal path alongside NOWPayments above —
# NOWPayments is NOT replaced or removed. This app itself signs and
# broadcasts real TON transfers using this seed phrase, so treat it with
# the same care as the money it controls:
#   - MASTER_TON_MNEMONIC is the 24-word seed phrase of the platform's
#     shared hot wallet. Anyone who obtains it can drain every user's and
#     the platform's TON balance. Set it ONLY as an encrypted Vercel
#     Environment Variable — never commit it, never paste it in chat.
#   - MASTER_HOT_WALLET_ADDRESS is that same wallet's public address
#     (safe to share) — shown to users as the deposit address.
#   - All users share ONE address; deposits are attributed to the right
#     user by a unique memo/comment (see User.tonMemo), not a separate
#     on-chain wallet per user.
#   - TON_API_KEY: free key from https://t.me/tonapibot (toncenter.com).
#   - TON_NETWORK: "mainnet" (real funds) or "testnet" (get free test
#     coins from https://t.me/testgiver_ton_bot — verify everything on
#     testnet before ever setting mainnet + a real mnemonic).
# Deposits are picked up by a daily cron (/api/cron/ton-deposits) — Vercel
# Hobby caps cron at once/day, so a deposit can take up to ~24h to credit.
MASTER_TON_MNEMONIC=
MASTER_HOT_WALLET_ADDRESS=
TON_API_KEY=
TON_NETWORK=testnet
# Owner's OWN personal external TON wallet — a plain address, safe to
# share, NOT a seed phrase. The platform's real net profit (tracked in
# PlatformSettings.accumulatedOwnerProfit) is swept here automatically
# once it exceeds OWNER_SWEEP_THRESHOLD, checked on the same daily cron as
# the deposit scan. Threshold defaults to $15 if unset — kept above $10 on
# purpose so the swept amount comfortably covers TON's small network fee.
OWNER_CWALLET_ADDRESS=
OWNER_SWEEP_THRESHOLD=15

# ===== Auto-moderation link safety (optional) =====
# Powers the automatic unsafe-link check on newly created LINK ads. Get a
# free key at console.cloud.google.com → enable "Safe Browsing API" →
# Credentials → API key. Leave empty to skip this check silently (the
# banned-word filter still runs either way).
GOOGLE_SAFE_BROWSING_API_KEY=

# ===== Deployment =====
# Set this to your final free domain, e.g. https://ttbik.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Free key from https://www.pexels.com/api/ — real footage for the story-video tool («رموز»)

# ===== Nova Coder Mini App OAuth connectors (optional) =====
# Vercel Sign in with Vercel app: create it in the Vercel dashboard and register the exact callback below.
# Callback: https://ttbik-gate.jonsnowx1r.workers.dev/api/coder/app/connectors/vercel/callback
# Add both values as encrypted Environment Variables in Vercel (Production; Preview optional), then redeploy.
CODER_VERCEL_CLIENT_ID=
CODER_VERCEL_CLIENT_SECRET=

# Google Calendar shares the Google OAuth app with Drive/Gmail; enable Calendar API in Google Cloud.
CODER_GOOGLE_CLIENT_ID=
CODER_GOOGLE_CLIENT_SECRET=
# GitLab OAuth app: https://gitlab.com/-/profile/applications
CODER_GITLAB_CLIENT_ID=
CODER_GITLAB_CLIENT_SECRET=

# ===== AI models, ModelScope Studios, and dedicated computer (local/Codespaces) =====
# This block documents local/Codespaces overrides. Most Studio URLs have matching
# defaults in src/lib; set an override only when you intentionally use another Studio.
#
# Required Secret for live ModelScope calls. Obtain it from the ModelScope account;
# never commit the real value or paste it into chat.
MODELSCOPE_API_TOKEN=
# Limited compatibility fallback only; MODELSCOPE_API_TOKEN is the primary name.
MODELSCOPE_TOKEN=
# Optional Nova/computer-specific token override; use only if its permissions differ.
OPEN_CODER_STUDIO_TOKEN=

# Nova coder inference Studio: required for live Nova coder/computer-agent inference.
OPEN_CODER_STUDIO_URL=https://studio-novaai2026-coder-inference-server.api-inference.modelscope.net
# Optional comma-separated Nova Studio replicas; keep each model on its own approved route.
OPEN_CODER_STUDIO_URLS=https://studio-novaai2026-coder-inference-server.api-inference.modelscope.net,https://studio-novaai2026-coder-inference-server-2.api-inference.modelscope.net,https://studio-novaai2026-coder-inference-server-3.api-inference.modelscope.net,https://studio-novaai2026-coder-inference-server-4.api-inference.modelscope.net,https://studio-novaai2026-coder-inference-server-5.api-inference.modelscope.net
OPEN_CODER_API_PREFIX=

# Model-specific Studio URL overrides. The code already contains the listed defaults;
# do not change these to another model's Studio.
SHAM_MODELSCOPE_URL=https://studio-novaai2026-sham-v1-server.api-inference.modelscope.net
SHAM_V2_URL=https://studio-novaai2026-sham-v2-server.api-inference.modelscope.net
SHAM_V2_VIDEO_URL=https://studio-novaai2026-sham-v2-video-server.api-inference.modelscope.net
SHAM_V2_IMAGE_STUDIO_URL=https://studio-novaai2026-realistic-vision-v6-test.api-inference.modelscope.net
NOVA_IMAGE_STUDIO_URL=https://studio-novaai2026-epicrealism-image-test.api-inference.modelscope.net
NOVA_MEDIA_STUDIO_URL=https://studio-novaai2026-nova-media-server.api-inference.modelscope.net
QWEN35_IMAGE_STUDIO_URL=https://studio-novaai2026-cyberrealistic-final-test.api-inference.modelscope.net
GEMMA4_IMAGE_STUDIO_URL=https://studio-novaai2026-gemma4-realistic-vision-v6-test.api-inference.modelscope.net
MINICPMO45_IMAGE_STUDIO_URL=https://studio-novaai2026-umranz-sd15-image-test.api-inference.modelscope.net
LFM_STUDIO_URLS=
LFM_STUDIO_URL=
LFM_MEDIA_STUDIO_URL=https://studio-novaai2026-lfm25-media-server.api-inference.modelscope.net

# Dedicated computer Studio. Never point this at a model inference or media Studio.
COMPUTER_STUDIO_URL=https://studio-novaai2026-nova-inference-server.api-inference.modelscope.net

# Development-only task-token encryption key. Generate a separate value for this
# Codespace/local environment; do not replace the production/Oracle shared key.
CODER_TOKEN_KEY=
# Optional GitHub personal access token only when account-linked GitHub auth is unavailable.
CODER_GITHUB_TOKEN=
# Optional app/runtime routing settings for local continuation and Mini App testing.
CODER_BOT_ID=
CODER_APP_URL=https://ttbik.vercel.app/coder-app
CODER_SELF_URL=http://localhost:3000

# DATABASE_URL is defined above. For local/Codespaces tests use an isolated development
# database, not the production database. Telegram bot credentials are loaded from the
# configured bot row in the database for the Nova Mini App; do not add a live bot token
# here unless a separate isolated test bot is being configured.

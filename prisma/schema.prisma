// Session Pooler only (no directUrl) — Supabase's direct connection is
// IPv6-only and unreachable from IPv4-only networks/hosts, which was
// breaking `prisma db push`/migrate. The Session Pooler (port 5432,
// non-transaction mode) supports prepared statements, so it works for
// both app queries and migrations — one URL covers everything.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  BOT_OWNER
  SUPER_ADMIN
}

enum AdType {
  LINK
  TELEGRAM
  YOUTUBE
  TWITTER
  TIKTOK
  FACEBOOK
  INSTAGRAM
}

model Bot {
  id            String   @id @default(uuid())
  token         String   @unique
  ownerId       String // Telegram User ID of the bot creator
  template      String // "AD_BOT" | "STORE" | "HOSPITAL" | "MARRIAGE_BOT" | "JOBS_BOT" | "MEDICAL_BOT" | "NOVA_BOT"
  totalRevenue  Float    @default(0.0)
  ownerBalance  Float    @default(0.0) // creator's withdrawable commission (matured, past the 48h hold)
  pendingBalance Float   @default(0.0) // creator commission still inside the 48h hold, not yet withdrawable — see CREATOR_EARNING_PENDING transactions
  isActive      Boolean  @default(true)
  webhookSecret String // Telegram setWebhook secret_token — verified on every incoming update so a guessed bot id alone can't forge updates
  requiredChannel String? // optional mandatory-subscription channel (@handle) the bot owner sets; non-owners must join before /start unlocks
  referredByOwnerId String? // Telegram ID of the bot-owner whose B2B referral link this bot was activated through (set once at deploy time, /bots?ref=)
  created_at    DateTime @default(now())
  ads           Ad[]
}

model User {
  id             String        @id // Telegram User ID
  botId          String
  role           Role          @default(USER)
  balance        Float         @default(0.0)
  depositAddress String?
  // Native TON deposit attribution (owner spec, 2026-09-02): the platform
  // uses ONE shared hot wallet (MASTER_HOT_WALLET_ADDRESS) for all native
  // TON/USDT-TON deposits — not a separate on-chain subwallet per user —
  // and tells each user apart by this unique memo/comment they attach to
  // their transfer. Deposits still land in the same unified User.balance
  // (converted to its USD value at credit time), same as NOWPayments
  // deposits already do — one wallet ledger for the whole platform, not a
  // second parallel TON-only balance.
  tonMemo        String?       @unique
  tonTransactions TonTransaction[]
  referredBy     String?
  language       String        @default("ar") // "ar" | "en" — persisted UI language preference
  // Phone verification via Telegram's native "share contact" button —
  // the closest honest substitute for "account age ≥ 30 days": the
  // official Bot API exposes no account-creation date at all, so this
  // trades that unbuildable check for real friction (a phone number tied
  // to the account) instead of a fake heuristic.
  phoneNumber    String?
  phoneVerified  Boolean       @default(false)
  // Set when this account's device fingerprint collides with >= 2 other
  // distinct accounts (see DeviceFingerprint) — blocks further task
  // payouts pending manual review rather than an automatic ban, since
  // basic browser fingerprinting has real false-positive risk (shared
  // devices, NAT).
  multiAccountFlag Boolean     @default(false)
  // Tracks a mid-flight multi-step conversation (e.g. "creating an ad,
  // waiting for the budget"). Vercel serverless functions don't keep
  // in-memory state between requests, so this has to live in the DB —
  // not part of Gemini's original schema, added because grammy's
  // in-memory session middleware would silently lose state on cold starts.
  pendingAction  Json?
  created_at     DateTime      @default(now())
  ads            Ad[]
  transactions   Transaction[]
}

model Ad {
  id          String   @id @default(uuid())
  userId      String // advertiser
  botId       String // bot this campaign was created in (the advertiser's own bot)
  type        AdType
  content     String // target link/channel/video/handle
  description String? // advertiser's own ad copy, shown to viewers on the carousel card (owner audit fix, 2026-09-06: was collected during ad creation but silently dropped before this)
  totalBudget Float
  cpc         Float // cost per click/task, min $0.02
  ownerCut    Float // 30% platform
  creatorCut  Float // 20% — whichever bot's user completes the task, not necessarily the creating bot (see scope)
  workerCut   Float // 50% worker
  remaining   Float
  status      String   @default("ACTIVE") // ACTIVE | PAUSED (advertiser-paused, "إعلاناتي") | EXPIRED | CANCELLED (advertiser-cancelled, refunded) | REJECTED (failed auto-moderation) | FLAGGED (5+ user reports)
  reportCount Int      @default(0)
  // TARGETED: only shown inside the creating bot (targetBotId = botId).
  // GLOBAL: shown across every bot's "شاهد واربح" pool (targetBotId = null);
  // the 20% creator cut then goes to whichever bot's user completes it.
  scope       String   @default("TARGETED") // TARGETED | GLOBAL
  targetBotId String?
  created_at  DateTime @default(now())
  bot         Bot      @relation(fields: [botId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

// One row per (ad, reporter) — the 🚩 إبلاغ carousel button. Reaching 5
// distinct reporters auto-flips the ad to FLAGGED (see Ad.status).
model AdReport {
  id         String   @id @default(uuid())
  adId       String
  userId     String
  created_at DateTime @default(now())

  @@unique([adId, userId])
}

// Basic anti-multi-accounting signal: a composite browser fingerprint hash
// computed client-side on the /watch/[token] page, tied to whichever
// Telegram user completed that click. Not enterprise-grade (spoofable),
// but enough to catch the common case of one device farming several
// accounts back-to-back.
model DeviceFingerprint {
  id          String   @id @default(uuid())
  fingerprint String
  ip          String?
  userId      String
  created_at  DateTime @default(now())

  @@unique([fingerprint, userId])
}

model Transaction {
  id         String   @id @default(uuid())
  userId     String
  botId      String? // which bot this happened through — set for TASK_REWARD/PLATFORM_PROFIT (the bot the click occurred in) and OWNER_WITHDRAWAL (which bot's commission); null for wallet-level DEPOSIT/WITHDRAWAL, which aren't bot-scoped
  amount     Float
  currency   String // USDT, TRX, TON, LTC, SOL, ...
  type       String // DEPOSIT | WITHDRAWAL | TASK_REWARD | AD_PAYMENT | AD_REFUND | PLATFORM_PROFIT | OWNER_WITHDRAWAL | PENALTY | CREATOR_EARNING_PENDING | REFERRAL_COMMISSION | REFERRAL_B2B_COMMISSION
  status     String // PENDING | PENDING_AUDIT | COMPLETED | FAILED | REJECTED | RELEASED
  txHash     String? // NOWPayments payment_id, used for IPN idempotency
  destination String? // withdrawal payout address (TRC20/TON/etc) — set only for WITHDRAWAL/OWNER_WITHDRAWAL, so decideWithdrawal knows where to send on approval
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([txHash])
}

// Blockchain-level ledger for native TON/USDT-TON transfers through the
// shared MASTER_HOT_WALLET_ADDRESS (owner spec, 2026-09-02) — the source
// of idempotency for the deposit scanner (unique per on-chain txHash/lt)
// and the record of what was actually signed and broadcast for a
// withdrawal. Each processed row also creates a normal Transaction
// (type DEPOSIT/WITHDRAWAL, currency "TON") so the user's wallet history
// stays unified regardless of which gateway moved the money — this table
// is the TON-specific detail behind that entry, not a second balance.
// Singleton row (id always 1) tracking the platform's real net TON profit
// accumulated since the last sweep to the owner's personal external wallet
// — owner spec, 2026-09-02. Incremented atomically alongside every
// PLATFORM_PROFIT transaction in payoutTask; read/reset by
// checkAndSweepOwnerProfits in ton-service.ts.
model PlatformSettings {
  id                     Int      @id @default(1)
  accumulatedOwnerProfit Float    @default(0.0)
  updatedAt              DateTime @updatedAt
}

model TonTransaction {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String // DEPOSIT | WITHDRAWAL | OWNER_SWEEP
  asset      String   @default("TON") // TON | USDT — which on-chain asset amountTon is denominated in
  amountTon  Float // amount in the deposited asset's own units (TON or USDT), despite the field name
  usdValue   Float // converted to USD at the rate used to credit/debit User.balance (USDT uses ~1:1, no rate lookup)
  txHash     String   @unique // on-chain transaction hash/logical-time — the idempotency key
  toAddress  String? // withdrawal destination only; null for deposits (always the shared hot wallet)
  status     String   @default("PENDING") // PENDING | COMPLETED | FAILED
  created_at DateTime @default(now())
}

// Per-user click/timer state for the "زيارة الموقع (15 ثانية)" anti-cheat
// gate on non-Telegram ads (LINK/YOUTUBE/TWITTER/TIKTOK/FACEBOOK/INSTAGRAM).
// The public /watch/[token] countdown page reads/writes this row (token =
// this row's id); the carousel's "✅ تحقق من الإنجاز" handler only pays out
// once verified is true. Re-clicking the "visit" button resets issuedAt and
// verified via upsert on the (adId, userId) unique key, so a stale timer
// can't be replayed after it expires.
model AdClick {
  id         String   @id @default(uuid())
  adId       String
  userId     String
  botId      String
  issuedAt   DateTime @default(now())
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@unique([adId, userId])
}

// A paid "أريد بوتاً مماثلاً" request (owner spec, 2026-08-31): buying a
// license to deploy your own bot via /bots, instead of that page being
// open to anyone. Flow: buyer submits a bank-transfer reference from
// inside any deployed bot -> SUPER_ADMIN reviews with موافقة شراء/رفض شراء
// -> approval generates `code` and DMs it to the buyer -> /bots/deploy
// requires that exact code, tied to the same buyerId, and flips status to
// REDEEMED so it can't be reused for a second bot.
model BotPurchase {
  id                String   @id @default(uuid())
  buyerId           String // Telegram ID of the purchaser — must match the ownerId used at redemption
  code              String?  @unique // generated only once approved; null while PENDING/REJECTED
  amount            Float    @default(100.0)
  status            String   @default("PENDING") // PENDING | APPROVED | REDEEMED | REJECTED
  transferReference String?
  created_at        DateTime @default(now())
}

// ===================================================================
// MARRIAGE_BOT — a fully separate matchmaking/marriage template (owner
// spec, 2026-09-02). Deliberately independent from the AD_BOT models
// above (User/Ad/Transaction carry ad-network-specific fields with no
// meaning here) — shares only the hosting shell (Bot.template routing,
// webhook, deploy gate). No wallet/monetization in this version; paid
// features are a later, separate addition.
// ===================================================================

// A person's identity within a MARRIAGE_BOT instance — phone-verified
// before any profile can be created, given how sensitive this context is.
model MatchUser {
  id             String    @id // Telegram User ID
  botId          String // which MARRIAGE_BOT instance (multi-tenant, same pattern as Bot/User above)
  phoneNumber    String?
  phoneVerified  Boolean   @default(false)
  language       String    @default("ar")
  pendingAction  Json?
  lastActiveAt   DateTime  @default(now()) // drives "متصل الآن" vs "آخر ظهور" on result cards
  isBanned       Boolean   @default(false) // admin action from a reviewed report — blocks all bot use
  mutedUntil     DateTime? // admin action from a reviewed report — temporary block, lifts on its own once past
  created_at     DateTime  @default(now())

  // MARRIAGE_BOT's own wallet fields (owner spec, 2026-09-05) — deliberately
  // separate from AD_BOT's User.balance/User.tonMemo. Reusing that table
  // would have meant a MARRIAGE_BOT deposit crediting the exact same
  // balance as any AD_BOT the same Telegram user has elsewhere (both
  // NOWPayments' webhook and the TON scanner key purely off Telegram ID) —
  // confirmed as a real risk, not a theoretical one. See MatchTransaction.
  balance        Float     @default(0.0)
  tonMemo        String?   @unique

  // Paid feature unlocks (owner spec, 2026-09-05) — one-time purchases,
  // permanent once bought (unlike boostedUntil/vipUntil, which expire).
  advancedFiltersUnlocked Boolean  @default(false)
  profileVisitorsUnlocked Boolean  @default(false)
  extraPhotosUnlocked     Boolean  @default(false)
  // Golden VIP membership — while active, also grants advanced filters,
  // profile visitors, incognito, and a continuously-refreshed boost
  // without needing the individual one-time unlocks. See isVipActive().
  vipUntil                DateTime?
  // Referral growth (owner spec, 2026-09-05) — set once at account
  // creation from a /start ref_<id> deep link; never overwritten after.
  referredBy              String?
  // Guards against re-granting the referrer's reward if this user's
  // profile gets re-approved later (editing an approved profile sends it
  // back to PENDING for re-review) — the reward is a one-time thing per
  // referred person, not per approval event.
  referralRewardGranted   Boolean  @default(false)

  profile        MatchProfile?
  preference     PartnerPreference?
  likesGiven     MatchLike[]        @relation("LikesGiven")
  likesReceived  MatchLike[]        @relation("LikesReceived")
  blocksGiven    MatchBlock[]       @relation("BlocksGiven")
  blocksReceived MatchBlock[]       @relation("BlocksReceived")
  reportsGiven   MatchReport[]      @relation("ReportsGiven")
  reportsReceived MatchReport[]     @relation("ReportsReceived")
  queueEntries   RandomChatQueue[]
  adminMessages  AdminMessage[]
  transactions   MatchTransaction[]
}

// MARRIAGE_BOT's own financial ledger — fully isolated from AD_BOT's
// User/Transaction/TonTransaction tables. Nothing in adBotLogic.ts or
// ton-service.ts ever reads or writes this table, and nothing that touches
// this table ever reads or writes prisma.user/prisma.transaction. Real-world
// custody (the one NOWPayments merchant account, the one shared TON hot
// wallet) is still pooled with AD_BOT's — that's normal, like a bank's
// omnibus account — but the internal bookkeeping never crosses over.
model MatchTransaction {
  id         String    @id @default(uuid())
  userId     String
  user       MatchUser @relation(fields: [userId], references: [id])
  amount     Float
  currency   String // USD-equivalent value credited/charged
  type       String // DEPOSIT | BOOST | VERIFIED_BADGE | EXTRA_PHOTOS | PROFILE_VISITORS | ADVANCED_FILTERS | SUPER_LIKE | VIP_MEMBERSHIP | REFERRAL_REWARD
  status     String    @default("COMPLETED")
  txHash     String? // NOWPayments payment_id / TON on-chain tx hash — IPN & scan idempotency
  created_at DateTime  @default(now())

  @@unique([txHash])
}

// Own profile — goes through SUPER_ADMIN manual approval (status) before
// it can ever appear in another user's search results.
model MatchProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          MatchUser @relation(fields: [userId], references: [id])
  gender        String // MALE | FEMALE
  name          String
  age           Int
  country       String
  job           String?
  education     String?
  attributes    String? // free-text description (height, build, etc.)
  city          String? // optional, free for everyone to set — only usable as a SEARCH filter by someone with advanced filters unlocked (see hasAdvancedFilters)
  maritalStatus String? // optional, same as above
  contactMethod String // TELEGRAM | WHATSAPP
  contactValue  String // @username, or a phone number for a wa.me link
  photoFileId   String? // Telegram file_id of the uploaded profile photo — null shows an empty placeholder
  photoFileId2  String? // paid extra photo slot (see EXTRA_PHOTOS feature) — sent as a follow-up message, not part of the main card
  photoFileId3  String? // paid extra photo slot
  voiceFileId   String? // Telegram file_id of an optional short (~15s) voice intro — recorded as a normal Telegram voice message, no new upload UI needed
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  isHidden      Boolean   @default(false) // user-toggled pause — excluded from search results without deleting the profile
  // Paid features (owner spec, 2026-09-05) — see MatchTransaction for the
  // pricing/charge side.
  boostedUntil  DateTime? // profile sorts first in search results until this timestamp — PROFILE_BOOST purchase, or continuously refreshed while MatchUser.vipUntil is active
  verificationStatus String @default("NONE") // NONE | PENDING | VERIFIED | REJECTED — the ☑️ badge shown next to the name on search cards
  verificationPhotoFileId String? // ID photo submitted for the verification review — visible only to SUPER_ADMIN, never shown to other users
  isIncognito   Boolean   @default(false) // only has effect while the owner's MatchUser.vipUntil is active — see isVipActive()
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

// Who viewed whose profile in search results (owner spec, 2026-09-05) —
// upserted per (owner, viewer) pair so this stays one row per relationship
// (most-recent visit), not an ever-growing log. Powers the paid "من زار
// ملفي" feature. A visit is skipped entirely when the VIEWER has
// incognito active (see sendSearchCard) — incognito hides your own
// activity from others, not what others did to you.
model MatchProfileVisit {
  id        String   @id @default(uuid())
  ownerId   String
  viewerId  String
  visitedAt DateTime @default(now())

  @@unique([ownerId, viewerId])
}

// Photo access consent (owner spec, 2026-09-05) — a profile's photo is
// hidden from search-card viewers by default; a viewer must request
// access and the owner must explicitly grant it before the real photo is
// ever sent to that specific viewer. Stronger than a cosmetic blur (which
// would need real image processing) and arguably better privacy: nothing
// is sent at all until consent, rather than a still-partially-visible blur.
model MatchPhotoPermission {
  id         String   @id @default(uuid())
  ownerId    String // whose photo this is
  viewerId   String // who requested to see it
  status     String   @default("PENDING") // PENDING | GRANTED | DENIED
  created_at DateTime @default(now())

  @@unique([ownerId, viewerId])
}

// What this user is looking for in a partner — a separate form/record
// from their own profile above. Every field nullable ("لا يهم"), except
// country which drives the one-directional-vs-mutual matching rule.
model PartnerPreference {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       MatchUser @relation(fields: [userId], references: [id])
  country    String // required — drives the one-directional-vs-mutual matching rule, never skippable
  ageMin     Int?
  ageMax     Int?
  job        String?
  education  String?
  attributes String?
  // Advanced filters (paid, owner spec, 2026-09-05) — only ever set/used
  // once MatchUser.advancedFiltersUnlocked (or an active VIP membership)
  // is true; harmless if set otherwise, just unused by buildSearchQueue.
  city            String?
  maritalStatus   String?
  updated_at DateTime  @updatedAt
}

model MatchLike {
  id         String    @id @default(uuid())
  fromUserId String
  fromUser   MatchUser @relation("LikesGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     MatchUser @relation("LikesReceived", fields: [toUserId], references: [id])
  note       String? // Super Like (paid, owner spec, 2026-09-05) — a short message attached to the like, visible only inside the recipient's own "من أعجب بي" list, never pushed as a forced DM
  created_at DateTime  @default(now())

  @@unique([fromUserId, toUserId])
}

// Shared between "البحث عن شريك" and "المراسلة العشوائية" — a block in
// either feature means the same thing: never connect these two again.
model MatchBlock {
  id         String    @id @default(uuid())
  blockerId  String
  blocker    MatchUser @relation("BlocksGiven", fields: [blockerId], references: [id])
  blockedId  String
  blocked    MatchUser @relation("BlocksReceived", fields: [blockedId], references: [id])
  created_at DateTime  @default(now())

  @@unique([blockerId, blockedId])
}

model MatchReport {
  id         String    @id @default(uuid())
  reporterId String
  reporter   MatchUser @relation("ReportsGiven", fields: [reporterId], references: [id])
  targetId   String
  target     MatchUser @relation("ReportsReceived", fields: [targetId], references: [id])
  reason     String?
  source     String    @default("SEARCH") // SEARCH (from a search-result card) | RANDOM_CHAT — drives the admin panel's two separate report queues
  status     String    @default("PENDING") // PENDING | REVIEWED — set once an admin acts on it (ignore/mute/ban)
  created_at DateTime  @default(now())
}

// A user-initiated message to the admin (owner spec, 2026-09-02) — gated
// behind a strongly-worded misuse warning in the bot UI (see matchBotLogic's
// contact-admin flow), so this table is meant to stay low-volume and every
// row genuinely worth the admin's attention.
model AdminMessage {
  id         String    @id @default(uuid())
  senderId   String
  sender     MatchUser @relation(fields: [senderId], references: [id])
  text       String
  status     String    @default("PENDING") // PENDING | READ
  created_at DateTime  @default(now())
}

// Random-chat waiting room (owner spec, 2026-09-02) — see matchBotLogic.ts
// for the exact matching mechanics. At most one WAITING row per user at a
// time; a match immediately flips both rows to MATCHED and creates a
// RandomChatSession. expiresAt is checked at match time only (lazy
// expiry) — there's no background job that actively closes stale rows,
// per the hosting constraint discussed with the owner.
model RandomChatQueue {
  id         String    @id @default(uuid())
  userId     String
  user       MatchUser @relation(fields: [userId], references: [id])
  botId      String
  status     String    @default("WAITING") // WAITING | MATCHED
  expiresAt  DateTime
  sessionId  String?
  created_at DateTime  @default(now())
}

// One anonymous random-chat pairing. Also the source of the 24h
// "don't reconnect the same two people right away" cooldown — checked by
// querying for any session between the same two users within 24h,
// regardless of status.
model RandomChatSession {
  id                  String    @id @default(uuid())
  user1Id             String
  user2Id             String
  botId               String
  status              String    @default("ACTIVE") // ACTIVE | ENDED
  // Formal-contact-request flow (owner spec, 2026-09-05): after enough
  // messages, both sides are offered a one-time button to request
  // exchanging real contact info (from their own MatchProfile, if any).
  messageCount        Int       @default(0)
  contactOfferSent    Boolean   @default(false) // the one-time offer button was already shown — don't show it again every message past the threshold
  contactRequestedBy  String? // set once the first side taps the button; the exchange happens once the second side also agrees
  created_at          DateTime  @default(now())
  ended_at            DateTime?
}

// ===================================================================
// JOBS_BOT — فرص عمل + متجر بيع وشراء (owner spec, 2026-09-05). A
// second owner-only private bot template, same governance model as
// MARRIAGE_BOT: gated by JOBS_BOT_CREATOR_PASSWORD, never sold or
// activated for anyone else. Fully independent tables — nothing here is
// read or written by adBotLogic.ts, matchBotLogic.ts, ton-service.ts, or
// marriageTonService.ts, and vice versa.
// ===================================================================
model JobsUser {
  id            String    @id // Telegram User ID
  botId         String // only ever one JOBS_BOT instance, per owner policy — same field convention as User/MatchUser regardless
  phoneNumber   String?
  phoneVerified Boolean   @default(false)
  pendingAction Json?
  lastActiveAt  DateTime  @default(now())
  isBanned      Boolean   @default(false)
  mutedUntil    DateTime?
  created_at    DateTime  @default(now())

  // JOBS_BOT's own isolated financial ledger — same reasoning as
  // MatchUser.balance: reusing AD_BOT's or MARRIAGE_BOT's tables would
  // mix money across bots. See JobsTransaction.
  balance Float   @default(0.0)
  tonMemo String? @unique

  profile        JobsProfile?
  jobPostings    JobPosting[]
  storeListings  StoreListing[]
  wantedListings StoreWantedListing[]
  transactions   JobsTransaction[]
}

// Base identity + exactly ONE exclusive role (owner spec, 2026-09-05): a
// user is either a job seeker, a job poster, a tradesperson/service
// provider, or a trader — never two at once. Which role is chosen
// determines which of the role-specific fields below actually apply; the
// others stay null. Published immediately on save — no admin
// pre-approval gate (unlike MatchProfile), this is a classifieds-style
// board, not a moderated matchmaking pool.
model JobsProfile {
  id     String   @id @default(uuid())
  userId String   @unique
  user   JobsUser @relation(fields: [userId], references: [id])

  name          String
  age           Int
  country       String
  governorate   String
  city          String
  contactMethod String // TELEGRAM | WHATSAPP
  contactValue  String

  roleType String // SEEKER | EMPLOYER | TRADER | PROFESSIONAL

  // [SEEKER] — what they're skilled in / looking for. Drives the
  // "🔀 مطابقة تلقائية" convenience search (auto-runs a job-posting
  // keyword search using this field) — the seeker is never listed or
  // browsable themselves, only a search input.
  seekerProfession String?

  // [EMPLOYER] — their business/shop identity, shown on every job
  // posting they publish (see JobPosting, a separate 1:many table since
  // one employer can post multiple vacancies over time).
  employerBusinessName String?

  // [PROFESSIONAL] — the single service they offer. category is chosen
  // from a fixed picklist (see PROFESSIONAL_CATEGORIES in
  // jobsBotLogic.ts) with a free-text "أخرى" fallback stored here
  // directly — matching uses simple loose text matching either way, so
  // the picklist is a UX convenience, not a hard taxonomy constraint.
  professionalCategory    String?
  professionalDescription String?

  isPaused   Boolean  @default(false) // user-toggled pause, same purpose as MatchProfile.isHidden
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// One job vacancy posting (owner spec, 2026-09-05) — an EMPLOYER can
// publish several over time. Matched against a SEEKER's search by simple
// substring/keyword overlap on title + keywords, not a fixed profession
// taxonomy (job titles are far too varied for that — see the owner's own
// reasoning for preferring this over rigid field matching).
model JobPosting {
  id            String   @id @default(uuid())
  posterId      String
  poster        JobsUser @relation(fields: [posterId], references: [id])
  title         String
  keywords      String // free-text, space/comma separated — searched together with title
  workersCount  Int      @default(1)
  governorate   String
  city          String
  description   String?
  contactMethod String // TELEGRAM | WHATSAPP
  contactValue  String
  status        String   @default("OPEN") // OPEN | FILLED
  created_at    DateTime @default(now())
}

model StoreListing {
  id             String   @id @default(uuid())
  sellerId       String
  seller         JobsUser @relation(fields: [sellerId], references: [id])
  title          String
  description    String?
  price          Float
  photoFileIds   Json? // array of Telegram file_id strings
  deliveryMethod String // PICKUP_MANUAL | SHIPPING — shipping is purely informational; sender/receiver arrange the actual courier between themselves, the bot never integrates real shipping logistics
  paymentMethod  String // MANUAL | ESCROW
  status         String   @default("ACTIVE") // ACTIVE | SOLD | REMOVED
  created_at     DateTime @default(now())
}

model StoreWantedListing {
  id          String   @id @default(uuid())
  buyerId     String
  buyer       JobsUser @relation(fields: [buyerId], references: [id])
  title       String
  description String?
  budget      Float?
  status      String   @default("ACTIVE") // ACTIVE | FULFILLED | REMOVED
  created_at  DateTime @default(now())
}

// One actual purchase against a StoreListing. Escrow flow (owner spec,
// 2026-09-05): ESCROWED means the buyer's JobsUser.balance was already
// debited and the amount is "in limbo" — it lives only in this row's
// `amount` field until release, never added to the seller's balance
// early. DELIVERED_CONFIRMED → RELEASED credits the seller. A daily cron
// auto-releases any order stuck at ESCROWED for 7+ days with no linked
// OPEN JobsDispute (see /api/cron/jobs-escrow-release).
model StoreOrder {
  id             String    @id @default(uuid())
  buyerId        String
  sellerId       String
  listingId      String
  amount         Float
  deliveryMethod String // PICKUP_MANUAL | SHIPPING
  status         String    @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | ESCROWED | RELEASED | REFUNDED | CANCELLED
  escrowedAt     DateTime?
  releasedAt     DateTime?
  created_at     DateTime  @default(now())
}

// A price negotiation attached to either someone's StoreListing (a buyer
// proposing a price instead of paying the listed price outright) or
// someone's StoreWantedListing (a seller proposing to fulfill a buyer's
// request) — owner spec, 2026-09-06. buyerId/sellerId are fixed roles
// regardless of which side initiated the offer; `price`/`lastOfferBy`
// track the current number on the table as either side counters it.
// Accepting always executes the deal at the CURRENT `price`, crediting
// `sellerId`/debiting `buyerId` — whoever proposed that price last is
// irrelevant once accepted. A WANTED-kind accept has no real StoreListing
// to attach the resulting StoreOrder to, so one is synthesized on the fly
// (see finalizeAcceptedOffer in jobsBotLogic.ts) — this keeps every
// existing escrow/dispute/auto-release code path working unchanged.
model StoreOffer {
  id          String   @id @default(uuid())
  kind        String // LISTING | WANTED
  listingId   String?
  wantedId    String?
  buyerId     String
  sellerId    String
  price       Float
  lastOfferBy String
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// Dispute on an ESCROWED StoreOrder (owner spec, 2026-09-05) — each side
// submits their statement/evidence independently (the bot never shows
// one party what the other already wrote, so neither can tailor a
// response to counter the other in real time). Resolution happens
// manually by the SUPER_ADMIN from the inbox's "نزاعات الطلبات" queue,
// and directly triggers the real balance movement.
model JobsDispute {
  id                     String    @id @default(uuid())
  orderId                String    @unique
  openedBy               String // userId of whichever side opened it
  buyerStatement         String?
  buyerEvidencePhotoIds  Json?
  sellerStatement        String?
  sellerEvidencePhotoIds Json?
  status                 String    @default("OPEN") // OPEN | BOTH_SUBMITTED | RESOLVED
  resolution             String? // RELEASED_TO_SELLER | REFUNDED_TO_BUYER
  created_at             DateTime  @default(now())
  resolvedAt             DateTime?
}

// A report with required text reason + optional evidence photo (owner
// spec, 2026-09-05) — an upgrade over MARRIAGE_BOT's one-tap report,
// since a marketplace/services context benefits far more from actual
// evidence than a matchmaking context does.
model JobsReport {
  id                  String   @id @default(uuid())
  reporterId          String
  targetId            String
  targetKind          String   @default("profile") // profile | posting | listing — which kind of row targetId points at
  reason              String
  evidencePhotoFileId String?
  status              String   @default("PENDING") // PENDING | REVIEWED
  created_at          DateTime @default(now())
}

model JobsBlock {
  id         String   @id @default(uuid())
  blockerId  String
  blockedId  String
  created_at DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model JobsAdminMessage {
  id         String   @id @default(uuid())
  senderId   String
  text       String
  status     String   @default("PENDING") // PENDING | READ
  created_at DateTime @default(now())
}

// JOBS_BOT's own financial ledger — fully isolated from AD_BOT's and
// MARRIAGE_BOT's tables, same reasoning as MatchTransaction (see its own
// comment). Real-world custody (one NOWPayments account, one shared TON
// hot wallet) is still pooled across all three bots — only the internal
// bookkeeping never crosses over.
model JobsTransaction {
  id         String   @id @default(uuid())
  userId     String
  user       JobsUser @relation(fields: [userId], references: [id])
  amount     Float
  currency   String
  type       String // DEPOSIT | ESCROW_HOLD | ESCROW_RELEASE | ESCROW_REFUND | WITHDRAWAL
  status     String   @default("COMPLETED")
  txHash     String?
  created_at DateTime @default(now())

  @@unique([txHash])
}

// ===================================================================
// Website tools (Grok O1) — isolated models, no overlap with AD_BOT /
// MARRIAGE_BOT. URL shortener first (G3), digital business card (G4).
// ===================================================================
model ShortLink {
  id          String    @id @default(cuid())
  code        String    @unique // 6-8 char base62
  targetUrl   String
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  ownerIpHash String?   // optional light rate-limit fingerprint, no PII store
  expiresAt   DateTime?
}

// Digital business card / Linktree-style page (G4). Public path /c/[slug].
// editToken is a high-entropy bearer secret returned once at create;
// required for later PATCH. Generated with crypto.randomBytes, never Math.random.
model DigitalCard {
  id          String   @id @default(cuid())
  slug        String   @unique // 4-24 chars, [a-z0-9-_]
  title       String
  bio         String?
  avatarUrl   String?  // optional external https image URL only
  links       Json     // array of { label: string, url: string, order?: number }
  theme       String   @default("simple") // simple | dark | brand
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerIpHash String?  // light rate-limit fingerprint, no PII
  editToken   String   @unique // bearer secret for anonymous edit access
}

// ===================================================================
// MEDICAL_BOT (owner spec, 2026-09-04) — patient-facing medical/pharmacy
// directory + appointment booking, fully isolated from every other bot's
// tables/ledger (same reasoning as JOBS_BOT/MARRIAGE_BOT: money/PII never
// crosses bot boundaries). Scope is deliberately what the owner actually
// asked for after two planning rounds: clinics, hospitals (with
// departments), pharmacies, bookings, and a map — no blood bank, no lab
// reports, no separate ambulance-dispatcher role (explicitly ruled out
// or deferred). The "طوارئ" feature is a nearest-hospitals directory
// with a phone number to call directly, never framed as an automatic
// ambulance dispatch — there is no real emergency-service integration
// behind it, and implying otherwise in an actual emergency would be
// dangerous.
// ===================================================================

model MedUser {
  id            String   @id // Telegram User ID
  botId         String // only ever one MEDICAL_BOT instance, per owner policy — same field convention as JobsUser/MatchUser
  role          String   @default("PATIENT") // PATIENT | CLINIC | HOSPITAL | PHARMACY
  fullName      String?
  phone         String?
  pendingAction Json?
  isBanned      Boolean  @default(false)
  created_at    DateTime @default(now())

  patientProfile      MedPatientProfile?
  facility            MedFacility?
  appointments        MedAppointment[]
  prescriptionQueries MedPrescriptionQuery[]
}

// Created only when role stays PATIENT (the default). country/province/
// city/area is free text (same pattern as JobsProfile) — the real search
// signal is latitude/longitude, captured via Telegram's native "share
// location" button, not this free-text address.
model MedPatientProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       MedUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender     String
  country    String
  province   String
  city       String
  area       String
  latitude   Float
  longitude  Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// One row per clinic / hospital / pharmacy account, created when its
// owner redeems a MedActivationCode. type=CLINIC facilities book through
// their own MedDoctor row directly (facilityId set on the doctor,
// departmentId null); type=HOSPITAL facilities group doctors under
// MedDepartment instead (departmentId set, facilityId null on the
// doctor) — see MedDoctor. type=PHARMACY never has doctors.
model MedFacility {
  id         String   @id @default(uuid())
  ownerId    String   @unique
  owner      MedUser  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type       String // CLINIC | HOSPITAL | PHARMACY
  name       String
  phone      String
  country    String
  province   String
  city       String
  area       String
  address    String
  latitude   Float
  longitude  Float
  isDuty     Boolean  @default(false) // pharmacies only — on-duty toggle, set manually by the pharmacist
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  departments         MedDepartment[]
  doctors             MedDoctor[] // only populated for CLINIC-type facilities (their own single doctor row)
  prescriptionQueries MedPrescriptionQuery[]
}

// Departments only ever belong to a HOSPITAL-type facility.
model MedDepartment {
  id         String      @id @default(uuid())
  facilityId String
  facility   MedFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String // "عظمية"، "أطفال"، ...
  created_at DateTime    @default(now())

  doctors MedDoctor[]
}

// The single bookable unit, whether it belongs to a clinic (facilityId
// set) or a hospital department (departmentId set) — never both. One
// model for both cases means the booking flow never branches on facility
// type.
model MedDoctor {
  id           String         @id @default(uuid())
  facilityId   String?
  facility     MedFacility?   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   MedDepartment? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  specialty    String
  workingDays  String // "Sat,Sun,Mon"
  workingHours String // "09:00-15:00"
  feeUsd       Float?
  isActive     Boolean        @default(true)
  created_at   DateTime       @default(now())

  appointments MedAppointment[]
}

model MedAppointment {
  id              String               @id @default(uuid())
  patientId       String
  patient         MedUser              @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          MedDoctor            @relation(fields: [doctorId], references: [id])
  // Resolved to a real calendar date+time at booking time (the chosen
  // weekday's next actual occurrence, combined with the patient's entered
  // time) — not stored as a bare weekday string, so the reminder cron can
  // actually compare it against "now + 24h" / "now + 1h".
  appointmentAt   DateTime
  status          String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  notes           String?
  reminder24hSent Boolean              @default(false)
  reminder1hSent  Boolean              @default(false)
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
}

// Patient asks a specific pharmacy about a prescription (photo or text) —
// a simple two-way relay, same pattern as JobsAdminMessage/AdminMessage
// elsewhere in this project.
model MedPrescriptionQuery {
  id             String         @id @default(uuid())
  patientId      String
  patient        MedUser        @relation(fields: [patientId], references: [id])
  facilityId     String
  facility       MedFacility    @relation(fields: [facilityId], references: [id])
  patientMessage String // text, or a Telegram file_id prefixed "photo:" for images
  reply          String?
  status         String   @default("PENDING") // PENDING | ANSWERED
  created_at     DateTime @default(now())
}

// Minted by the SUPER_ADMIN inside the bot for a specific role, redeemed
// once by whoever registers as that clinic/hospital/pharmacy — same
// single-use activation-code pattern as BotPurchase, scoped to this bot's
// own isolated table.
model MedActivationCode {
  id         String   @id @default(uuid())
  code       String   @unique
  role       String // CLINIC | HOSPITAL | PHARMACY
  isRedeemed Boolean  @default(false)
  redeemedBy String?
  created_at DateTime @default(now())
}

// ===================================================================
// NOVA AI — the owner's $0-cost AI assistant product (owner spec,
// 2026-09-05). Fully isolated tables/ledger, same reasoning as every
// other bot here: money/identity never crosses bot boundaries.
//
// Architecture: this Prisma/Supabase layer is ONLY the shared identity
// + quota/subscription ledger. The actual AI logic (model council,
// RAG, MoE routing) lives in a separate Python FastAPI service under
// ai-system/ in this same repo — Next.js never calls the model APIs
// directly. Three client channels share one NovaUser record:
//   - Telegram (NOVA_BOT template, src/lib/novaBotLogic.ts — a thin
//     HTTP client that forwards each message to the FastAPI /chat
//     endpoint and relays the answer)
//   - Streamlit web UI (ai-system/streamlit_app.py)
//   - External API consumers (apiKey-authenticated FastAPI callers)
// All three check/increment quota against the SAME NovaUser row via
// the FastAPI backend (which holds the Supabase service-role key
// itself, independent of Prisma) — Prisma/this schema is the source
// of truth for the table shape and for anything Next.js needs to read
// (e.g. an admin view), the FastAPI service talks to the same table
// directly via supabase-py.
//
// No automated checkout: subscriptions start PENDING_APPROVAL and are
// flipped to ACTIVE by the owner manually (same "أريد ترقية" ->
// owner-approves pattern already used for BotPurchase/withdrawals in
// this project) — never an automatic payment path, consistent with
// this project's standing product rule against auto-checkout.
// ===================================================================

model NovaUser {
  id                    String    @id @default(uuid())
  telegramId            String?   @unique // set when the user first talks via NOVA_BOT
  email                 String?   @unique // set when the user first logs into the Streamlit web UI
  apiKey                String?   @unique // issued on request for external API access
  // FREE | PRO_BASIC | PRO_PLUS | PRO_ULTRA — owner spec 2026-09-08:
  // everything the bot can do stays available to every tier (text,
  // vision, voice, files, image generation); tiers only scale HOW MUCH
  // of it you get per day/week, cheaper than a single flat $5 plan.
  // Exact numbers live in ai-system/app/quota.py's PLANS dict, kept in
  // one place so pricing can change without a migration.
  plan                  String    @default("FREE")
  subscriptionExpiresAt DateTime?
  // Daily counters, separate per media type since the owner wants a
  // much stricter cap on images specifically (heavier to compute) than
  // on plain text messages.
  dailyUsed             Int       @default(0) // text/voice/file messages today
  dailyUsedImage        Int       @default(0) // images today (understand + generate share one cap)
  dailyResetAt          DateTime  @default(now())
  // Weekly counters, same split — owner spec: "نفس النظام الذي تعمل
  // عليه أنت [Claude]" (a rolling weekly ceiling on top of the daily
  // one, so a paid plan can't be hammered non-stop every single day).
  weeklyUsedText        Int       @default(0)
  weeklyUsedImage       Int       @default(0)
  weeklyResetAt         DateTime  @default(now())
  created_at            DateTime  @default(now())
  usageLogs             NovaUsageLog[]
  subscriptions         NovaSubscription[]
}

model NovaUsageLog {
  id         String   @id @default(uuid())
  novaUserId String
  novaUser   NovaUser @relation(fields: [novaUserId], references: [id])
  channel    String // TELEGRAM | WEB | API
  queryType  String // CODE | GENERAL | LIVE_INFO — set by the MoE router, for cost/usage visibility only
  message    String? // the user's message — nullable so old rows stay valid; also doubles as real LoRA fine-tuning
  answer     String? // Nova's final answer — data for ai-system/colab/merge_and_finetune.ipynb's scheduled Kaggle run,
  // fetched over Supabase's REST API (never stored in the notebook itself) instead of the old hand-typed placeholder.
  // UP | DOWN | null (no feedback given) — set automatically by council.py's detect_dissatisfaction
  // (owner spec 2026-09-08: visible 👍/👎 buttons were removed — a button risks an accidental tap —
  // this reads the user's own next message instead, silently, with no UI element at all). Real
  // thumbs-down rows become the "rejected" half of a DPO preference pair, built directly inside
  // ai-system/colab/merge_and_finetune.ipynb — the self-improvement loop this doubles as.
  rating     String?
  created_at DateTime @default(now())
}

// Owner spec 2026-09-08: Nova should actively research topics it doesn't
// already know well, not just answer from its own weights — "يذهب للبحث
// على الانترنت عن بنك معلومات ويخزنه في المخازن التي صنعناها ويحلله
// ويتدرب عليه". rag.py's shared knowledge bank (a ChromaDB collection) is
// the fast in-memory side of that; this table is its durable twin, since
// Render's free-tier disk is NOT persistent — every restart/redeploy wipes
// ./chroma_data, which would otherwise silently reset the whole knowledge
// bank to empty. rag.py writes here on every new live search and rehydrates
// Chroma from here on first use after a cold start; the Kaggle notebook
// also reads this table directly (same Supabase REST pattern as
// NovaUsageLog) as an additional real training-data source.
model NovaKnowledgeEntry {
  id         String   @id @default(uuid())
  query      String // the question that triggered the search
  content    String // the (for GENERAL/CODE) analyzed answer, or (for LIVE_INFO) raw search snippets —
  // LIVE_INFO is deliberately NOT run through Groq synthesis: a price/date needs to stay exact,
  // not paraphrased, so rag.py stores those snippets as-is (same as before this table existed).
  source     String   @default("general") // "general" | "live_info" — doubles as rag.py's freshness category
  created_at DateTime @default(now())
}

model NovaSubscription {
  id         String    @id @default(uuid())
  novaUserId String
  novaUser   NovaUser  @relation(fields: [novaUserId], references: [id])
  plan       String // PRO_BASIC | PRO_PLUS | PRO_ULTRA (monthly) — see ai-system/app/quota.py's PLANS dict
  amountUsd  Float
  status     String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | ACTIVE | EXPIRED
  approvedBy String? // owner's Telegram ID who approved manually
  startedAt  DateTime?
  expiresAt  DateTime?
  created_at DateTime  @default(now())
}
